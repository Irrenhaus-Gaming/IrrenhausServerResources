# --- Safety net (mcdeploy): never track binaries, data, logs or key material anywhere under Minecraft/.
# Re-include a specific file with a "!" rule only after checking it contains no secrets.
Minecraft/**/*.jar
Minecraft/**/*.jar.*
Minecraft/**/*.db
Minecraft/**/*.db.*
Minecraft/**/*.duckdb
Minecraft/**/*.log
Minecraft/**/*.bak
Minecraft/**/*.backup
Minecraft/**/*.zip
Minecraft/**/*.mca
Minecraft/**/*.dat
Minecraft/**/*.pem
Minecraft/**/*.key
Minecraft/**/forwarding.secret
Minecraft/**/network-key
Minecraft/**/.backend-id
Minecraft/**/backend-id.txt
Minecraft/**/playerdata/

